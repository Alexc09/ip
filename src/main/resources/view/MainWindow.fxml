<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="crack.gui.MainWindow" prefWidth="420" prefHeight="600" spacing="8">
  <padding>
    <Insets top="8" right="8" bottom="8" left="8"/>
  </padding>

  <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
    <content>
      <VBox fx:id="dialogContainer"/>
    </content>
  </ScrollPane>

  <HBox spacing="8">
    <TextField fx:id="userInput" promptText="What we cooking?" onAction="#handleUserInput" HBox.hgrow="ALWAYS"/>
    <Button text="Send" onAction="#handleUserInput" defaultButton="true"/>
  </HBox>
</VBox>
